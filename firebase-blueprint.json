{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "E-Commerce product listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "sku": { "type": "string" },
        "categoryId": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "brand": { "type": "string" }
      },
      "required": ["title", "price"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer online order details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "shippingAddress": { "type": "object" },
        "items": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "totalAmount", "userId", "userEmail"]
    },
    "User": {
      "title": "User",
      "description": "User and Customer profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "approvalStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "fullName"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Storefront banner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id"]
    },
    "HealthPing": {
      "title": "HealthPing",
      "description": "Database connectivity check",
      "type": "object",
      "properties": {
        "client": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog products visible to public and manageable by store"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders created by customers"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered users"
    },
    "/customers/{customerId}": {
      "schema": "User",
      "description": "Registered customers"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Promotional banners"
    },
    "/_health/{pingId}": {
      "schema": "HealthPing",
      "description": "Health checks"
    }
  }
}
