rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check ping
    match /_health/{pingId} {
      allow read, write: if true;
    }

    // Products collection: public read, allow write for store managers / admin
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories: public read, write for store managers
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: public create, read/update
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Users & Customers: allow read/write
    match /users/{userId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Banners: public read, write for admin
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // Real-time Notifications: allow read, write
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Store Settings (Telegram Bot alerts, Store config): allow read, write
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
